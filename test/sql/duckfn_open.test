# name: test/sql/duckfn_open.test
# description: 冒烟测试：扩展能被加载，op_ 系列注册到位
# group: [duckfn_open]

# 加载之前这些名字不存在（每个 .test 文件都从一个干净的实例开始）
statement error
SELECT op_open_path('report.html');
----
Scalar Function with name op_open_path does not exist

statement error
SELECT op_open_commands('report.html');
----
Scalar Function with name op_open_commands does not exist

statement error
SELECT op_write_file('report', 'html');
----
Scalar Function with name op_write_file does not exist

statement error
SELECT op_print('report');
----
Scalar Function with name op_print does not exist

statement error
SELECT op_sanitize_filename('report:q3');
----
Scalar Function with name op_sanitize_filename does not exist

# require 之后扩展就位（测试框架按 --external-extension 加载本地产物）
require duckfn_open

# 九个 SQL 名字、二十一个签名，全在这个扩展的前缀下；不真调用（会 launch 的那些一步都不碰），只认 catalog
query T
SELECT string_agg(function_name, ',')
FROM (
    SELECT DISTINCT function_name
    FROM duckdb_functions()
    WHERE function_name LIKE 'op_%'
    ORDER BY function_name
);
----
op_open_commands,op_open_content,op_open_html,op_open_path,op_open_path_detached,op_print,op_sanitize_filename,op_sanitize_filename_check,op_write_file

# 签名总数：op_open_commands 1 + op_open_path 2 + op_open_path_detached 2 + op_write_file 4 + op_open_content 4 +
# op_open_html 1 + op_print 2 + op_sanitize_filename 3 + op_sanitize_filename_check 2
query I
SELECT count(*)
FROM duckdb_functions()
WHERE function_name LIKE 'op_%';
----
21

# 会碰外面世界的那六个名字注册成 volatile（catalog 里就是 has_side_effects）：它们起进程、落盘、写 stdout，
# 不能被优化器当成常量折叠 —— 否则一个调用会在优化期先执行一次，被折进别的表达式时再执行一次；纯字符串那一对
# 与只读预览则不是 volatile，折叠它们没有任何代价。
query T
SELECT string_agg(function_name, ',' ORDER BY function_name)
FROM (
    SELECT DISTINCT function_name
    FROM duckdb_functions()
    WHERE function_name LIKE 'op_%' AND has_side_effects
) t;
----
op_open_content,op_open_html,op_open_path,op_open_path_detached,op_print,op_write_file

query I
SELECT count(DISTINCT function_name)
FROM duckdb_functions()
WHERE function_name LIKE 'op_%' AND NOT has_side_effects;
----
3

# 只读预览在本机确实跑通了（这一步不起任何进程）
query T
SELECT len(op_open_commands('duckdb_open.test')) > 0;
----
true

# NULL 输入不会走到启动器：加载后第一次调用也保持这个语义
query T
SELECT op_open_path(NULL);
----
NULL
