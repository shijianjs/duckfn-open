# name: test/sql/op_open_html.test
# description: op_open_html：零配置快捷方式的注册形状、binder 拦截、NULL 短路
# group: [duckfn_open]

# 与 op_open_content.test 同一条理由：**任何真调用都会把默认浏览器叫起来**，那取决于这台机器的桌面配置，
# CI 的 runner 也没有桌面。所以这里只认 catalog 与那些到不了落盘的调用。
# 它写出的路径长什么样、临时目录怎么缺省，是 writer::write 的事（op_write_file.test 已经盯住了），
# 这个函数只是把后缀钉成 `html`、把三个可选项全部留空。

require duckfn_open

# ============================================================================
# 注册形状：一个名字、一个签名（内容 → 路径）
# ============================================================================

query TII
SELECT function_name, len(parameters), return_type
FROM duckdb_functions()
WHERE function_name = 'op_open_html'
ORDER BY len(parameters);
----
op_open_html	1	VARCHAR

# 只有文本那一路：输入是 HTML **文本**，二进制要先 CAST 或者走 op_open_content(blob, 'html')
query T
SELECT count(*) = 0
FROM duckdb_functions()
WHERE function_name = 'op_open_html' AND list_contains(parameter_types, 'BLOB');
----
true

# ============================================================================
# 参数个数与类型由 binder 拦下：它是零配置的快捷方式，不接选项，也不接第二个参数
# ============================================================================

statement error
SELECT op_open_html('<h1>hi</h1>', 'firefox');
----
Binder Error

statement error
SELECT op_open_html();
----
Binder Error

statement error
SELECT op_open_html(42);
----
Binder Error

# ============================================================================
# NULL：没有内容就没有文件，也就没有浏览器窗口
# ============================================================================

query T
SELECT op_open_html(NULL);
----
NULL

query I
SELECT count(*) FROM (VALUES (NULL), (NULL), (NULL)) t(c) WHERE op_open_html(c) IS NOT NULL;
----
0

# 空串不是 NULL：它是有内容的（一段空 HTML），所以会真的落盘并叫起浏览器 —— 这条留给人工验证，
# 测试里不跑它（见上面那段）。
