# name: test/sql/op_open_path.test
# description: op_open_path / op_open_path_detached：函数集里的签名形状、NULL 短路、参数校验、binder 拦截
# group: [duckfn_open]

require duckfn_open

# 注册形状：两个名字各两个 arity，返回值都是 BOOLEAN。
# 走 catalog 而不是真的调用 —— 真去 launch 一个文件的结果取决于这台机器的桌面配置（有没有 xdg-open、
# .html 关联到谁），断言不了；而 CI 的 runner 恰恰是没有桌面的那一种。
query TII
SELECT function_name, len(parameters), return_type
FROM duckdb_functions()
WHERE function_name IN ('op_open_path', 'op_open_path_detached')
ORDER BY function_name, len(parameters);
----
op_open_path	1	BOOLEAN
op_open_path	2	BOOLEAN
op_open_path_detached	1	BOOLEAN
op_open_path_detached	2	BOOLEAN

# 常量 NULL：由 duckfn 的参数读取层短路成 NULL，启动器一次都不会被叫起来
query T
SELECT op_open_path(NULL);
----
NULL

query T
SELECT op_open_path(NULL, 'firefox');
----
NULL

query T
SELECT op_open_path_detached(NULL);
----
NULL

# 运行期的 NULL 行同样整行短路：这一组里全是 NULL，所以没有任何一次 launch 发生
query I
SELECT count(*) FROM (VALUES (NULL), (NULL), (NULL)) t(s) WHERE op_open_path(s);
----
0

query I
SELECT count(*) FROM (VALUES (NULL), (NULL), (NULL)) t(s) WHERE op_open_path_detached(s);
----
0

# 空串不是路径也不是 URL，在边界上报错，而不是交出去换一个含义不明的 false
statement error
SELECT op_open_path('');
----
op_open_path: the path or URL must not be empty

statement error
SELECT op_open_path('report.html', '');
----
op_open_path: the application must not be empty

statement error
SELECT op_open_path_detached('');
----
op_open_path_detached: the path or URL must not be empty

statement error
SELECT op_open_path_detached('report.html', '');
----
op_open_path_detached: the application must not be empty

# 参数个数与类型由 binder 拦下（0 个、3 个、以及非 VARCHAR 的第一参数）
statement error
SELECT op_open_path();
----
Binder Error

statement error
SELECT op_open_path('a', 'b', 'c');
----
Binder Error

statement error
SELECT op_open_path(42);
----
Binder Error

# 函数集只以 SQL 名字存在：Rust 那两个分支名（op_open_path_with / op_open_path_detached_with）没有泄漏成
# 额外的 SQL 函数。这里逐个点名而不是按模式匹配 —— LIKE 的 `_` 是单字符通配，'%_with%' 会连别人的
# 名字一起命中。
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('op_open_path_with', 'op_open_path_detached_with');
----
0
