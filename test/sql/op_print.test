# name: test/sql/op_print.test
# description: op_print：注册形状、返回 NULL、逐行求值、NULL 短路
# group: [duckfn_open]

# 这个函数是唯一可以**真的调用**的：它不起进程、不碰文件系统，只往 stdout 写。写出去的那段文字落在
# 测试运行器自己的控制台里，不进结果集，所以断言只能盯着它的 SQL 结论 —— 恒为 NULL。
# （在 CLI 里手跑一遍才看得到效果：内容绕过了列宽与折行，这正是它存在的理由。）

require duckfn_open

# ============================================================================
# 注册形状：一个名字、两个签名（打不追加什么由第二个参数说）
# ============================================================================

query TI
SELECT function_name, len(parameters)
FROM duckdb_functions()
WHERE function_name = 'op_print'
ORDER BY len(parameters);
----
op_print	1
op_print	2

query T
SELECT count(DISTINCT return_type) = 1 AND min(return_type) = 'VARCHAR'
FROM duckdb_functions()
WHERE function_name = 'op_print';
----
true

# ============================================================================
# 真调用：内容已经在控制台上了，SQL 这一侧没有值可给
# ============================================================================

query T
SELECT op_print('hello');
----
NULL

# 空串也是「有内容」：打出去的是那个 tail
query T
SELECT op_print('');
----
NULL

# tail 照给的来，`''` 就是「接着同一行打」
query T
SELECT op_print('no newline', '');
----
NULL

query T
SELECT op_print('a line', chr(10) || chr(10));
----
NULL

# 逐行求值，所以三行打三次，每次都返回 NULL。参数里带上列引用（`'row ' || x`）而不是常量 ——
# 常量表达式会被折叠，那种写法只打一次，看不出「每行一次」。
query I
SELECT count(*) FROM (VALUES (1), (2), (3)) t(x) WHERE op_print('row ' || x) IS NULL;
----
3

# ============================================================================
# NULL：没有输入就没有可打的东西，函数体一次都不执行
# ============================================================================

query TT
SELECT op_print(NULL), op_print('a', NULL);
----
NULL	NULL

query I
SELECT count(*) FROM (VALUES (NULL), (NULL)) t(c) WHERE op_print(c) IS NOT NULL;
----
0

# ============================================================================
# 参数个数由 binder 拦下
# ============================================================================

statement error
SELECT op_print();
----
Binder Error

statement error
SELECT op_print('a', 'b', 'c');
----
Binder Error

statement error
SELECT op_print(42);
----
Binder Error

# Rust 的分支名没有泄漏成额外的 SQL 函数
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'op_print_with_tail';
----
0
