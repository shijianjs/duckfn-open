# name: test/sql/op_write_file.test
# description: op_write_file：四个签名的形状、路径与命名规则、BLOB 字节往返、选项校验、NULL 短路
# group: [duckfn_open]

# 这个函数不起进程，所以落盘的每一步在任何机器上都可断言（CI 的 runner 没有桌面也一样跑）。
# 写出去的内容用 DuckDB 自己的 read_text / read_blob 读回来验一眼 —— 否则「写进去的是不是这份内容」
# 只能靠信返回值。

require duckfn_open

# ============================================================================
# 注册形状：一个名字、四个签名（文本 / 二进制 × 带选项 / 不带选项）
# ============================================================================

query TI
SELECT function_name, len(parameters)
FROM duckdb_functions()
WHERE function_name = 'op_write_file'
ORDER BY len(parameters);
----
op_write_file	2
op_write_file	2
op_write_file	3
op_write_file	3

# 返回的是路径本身，不是布尔：这一步的产物是文件，启动是下一件事（op_open_path / op_open_content）
query T
SELECT typeof(op_write_file('hello', 'txt', {'dir':'__TEST_DIR__/shape','name':'plain','part':NULL}));
----
VARCHAR

# 四个候选里恰好两个是 BLOB 的（文本与二进制各一条不带选项、各一条带选项）
query T
SELECT count(*) = 2
FROM duckdb_functions()
WHERE function_name = 'op_write_file' AND list_contains(parameter_types, 'BLOB');
----
true

# ============================================================================
# 显式命名：目录 + `/` + 名字 + 补上的后缀
# ============================================================================

# 名字没写后缀时，必填的那个被补上；路径一律用 `/` 拼，所以这条断言在三个平台上同形
query T
SELECT op_write_file('report body', 'md', {'dir':'__TEST_DIR__/named','name':'report','part':NULL})
       = '__TEST_DIR__/named/report.md';
----
true

query T
SELECT content FROM read_text('__TEST_DIR__/named/report.md');
----
report body

# 后缀的比较不区分大小写：名字已经带着同一个后缀就不再补一次，两边的大小写各是哪一种都一样
query T
SELECT op_write_file('body', 'htm', {'dir':'__TEST_DIR__/casing','name':'REPORT.HTM','part':NULL})
       = '__TEST_DIR__/casing/REPORT.HTM';
----
true

query T
SELECT op_write_file('body', 'HTML', {'dir':'__TEST_DIR__/casing','name':'page.HTML','part':NULL})
       = '__TEST_DIR__/casing/page.HTML';
----
true

# 真要补，补的是调用方写的那个样子（`HTML` 就得到 `.HTML`）
query T
SELECT op_write_file('body', 'HTML', {'dir':'__TEST_DIR__/casing','name':'page','part':NULL})
       = '__TEST_DIR__/casing/page.HTML';
----
true

# 同名文件按「用户要的就是这个路径」覆盖：第二次只写了一个字节，第一次那行长内容不会留在后面
query T
SELECT op_write_file('a much longer first body', 'txt', {'dir':'__TEST_DIR__/overwrite','name':'twice','part':NULL})
       = '__TEST_DIR__/overwrite/twice.txt';
----
true

query T
SELECT op_write_file('x', 'txt', {'dir':'__TEST_DIR__/overwrite','name':'twice','part':NULL})
       = '__TEST_DIR__/overwrite/twice.txt';
----
true

query T
SELECT content FROM read_text('__TEST_DIR__/overwrite/twice.txt');
----
x

# 目录不存在时连父级一起建出来（写 dir 的人多半是说「我要放这儿」，不是「这儿已经在了」）
query T
SELECT content FROM read_text(
    op_write_file('nested body', 'txt', {'dir':'__TEST_DIR__/nested/a/b','name':'deep','part':NULL}));
----
nested body

# ============================================================================
# 自动命名：open-<时间>-<part>-<随机尾缀>.<后缀>
# ============================================================================

# 时间紧跟前缀（所以一个目录按名字排序就是按时间排序），part 里的空格并成 `_`，随机尾缀由 tempfile 给
query T
SELECT regexp_matches(
    op_write_file('x', 'svg', {'dir':'__TEST_DIR__/generated','name':NULL,'part':'Sales Overview'}),
    'open-[0-9]{8}-[0-9]{6}-Sales_Overview-[A-Za-z0-9]+\.svg$');
----
true

# 没给 part 就整段跳过（名字里只剩时间与随机尾缀），后缀照样必填
query T
SELECT regexp_matches(
    op_write_file('x', 'txt', {'dir':'__TEST_DIR__/generated','name':NULL,'part':NULL}),
    'open-[0-9]{8}-[0-9]{6}-[A-Za-z0-9]+\.txt$');
----
true

# 同一秒里连着两次自动命名也不撞名（随机尾缀与撞名重试都是 tempfile 的事），两条路径各自对应一个文件。
# 这里只认**这两个返回路径**，不数「目录里一共有几个文件」—— `__TEST_DIR__` 就是 test/sql，失败的那次
# 运行留下的残留不会被测试框架清掉，数总量就成了看运气的断言。
statement ok
CREATE TEMP TABLE auto_named AS (
    SELECT op_write_file('first', 'txt', {'dir':'__TEST_DIR__/unique','name':NULL,'part':NULL}) AS a,
           op_write_file('second','txt', {'dir':'__TEST_DIR__/unique','name':NULL,'part':NULL}) AS b
);

query T
SELECT a <> b FROM auto_named;
----
true

# 两个文件确实在磁盘上。顺带验了「返回值一律用 `/` 拼」那条约定：`glob` 的 `file` 列按**平台**分隔符给
# （Windows 上是 `\`），所以比之前把一侧归一化 —— 不归一化这条在 Windows 上永远配不上。
query T
SELECT count(*) = 2
FROM glob('__TEST_DIR__/unique/*') g, auto_named t
WHERE replace(g.file, chr(92), '/') IN (t.a, t.b);
----
true

# ============================================================================
# 二进制：字节原样落盘，不经 UTF-8
# ============================================================================

# PNG 的魔数（89 50 4E 47）从一个 BLOB 走进去、再从文件读回来，一个字节都没动
query T
SELECT op_write_file('\x89\x50\x4E\x47'::BLOB, 'png', {'dir':'__TEST_DIR__/blob','name':'magic','part':NULL})
       = '__TEST_DIR__/blob/magic.png';
----
true

query T
SELECT hex(content) FROM read_blob('__TEST_DIR__/blob/magic.png');
----
89504E47

# ============================================================================
# 求值次数：一个调用只写一个文件，折进别的表达式、或在 EXPLAIN 里也一样
# ============================================================================

# 这一族注册成 volatile（目录断言在 duckfn_open.test），所以它既不会被优化器折成常量、也不会在分析查询时
# 先跑一遍。下面的文件数就是这件事唯一可数的证据 —— 没有 volatile 时，折进 length(...) 会写两个文件，
# 而 EXPLAIN 会写一个。

# 折进别的表达式也只写一个文件
query T
SELECT length(op_write_file('body', 'txt', {'dir':'__TEST_DIR__/once','name':NULL,'part':NULL})) > 0;
----
true

query I
SELECT count(*) FROM glob('__TEST_DIR__/once/*');
----
1

# 常量参数不再被折成一次：三行就是三个文件
query I
SELECT count(*) FROM (VALUES (1), (2), (3)) t(x)
WHERE length(op_write_file('body', 'txt', {'dir':'__TEST_DIR__/each','name':NULL,'part':NULL})) > 0;
----
3

query I
SELECT count(*) FROM glob('__TEST_DIR__/each/*');
----
3

# 分析一条会落盘的查询，一个文件也不该落下来
statement ok
EXPLAIN SELECT op_write_file('body', 'txt', {'dir':'__TEST_DIR__/explain','name':NULL,'part':NULL});

query I
SELECT count(*) FROM glob('__TEST_DIR__/explain/*');
----
0

# ============================================================================
# 选项校验：错误要说清是哪一项
# ============================================================================

# 后缀必填、不能是空 —— 它是决定系统怎么看待这个文件的那一段，没有可猜的余地
statement error
SELECT op_write_file('a', '');
----
the extension must not be empty

# 带分隔符的「后缀」其实是一条路径：静默换成 `out_report.html` 只会写出一个谁也不认识的文件
statement error
SELECT op_write_file('a', 'out/report.html');
----
looks like a path

statement error
SELECT op_write_file('a', 'txt', {'dir':'   ','name':NULL,'part':NULL});
----
op_write_file_options.dir must not be empty

statement error
SELECT op_write_file('a', 'txt', {'dir':'__TEST_DIR__/badname','name':'/','part':NULL});
----
op_write_file_options.name is not a usable file name

# `name` 里的路径分隔符被替换掉，所以一个名字逃不出给定的目录
query T
SELECT op_write_file('a', 'txt', {'dir':'__TEST_DIR__/escape','name':'../evil:name','part':NULL})
       LIKE '__TEST_DIR__/escape/%';
----
true

# ============================================================================
# NULL：没有内容就没有文件，函数体一次都不执行
# ============================================================================

# 三个参数一视同仁 —— 选项那一项传 NULL 也是短路，**不是**「其余按缺省走」。要缺省就省略第 3 个参数
# （见文件末尾那条）。
query TTT
SELECT op_write_file(NULL, 'txt'), op_write_file('a', NULL), op_write_file('a', 'txt', NULL);
----
NULL	NULL	NULL

# 运行期的 NULL 行同样整行短路
query I
SELECT count(*) FROM (VALUES (NULL), (NULL)) t(c) WHERE op_write_file(c, 'txt') IS NOT NULL;
----
0

# 想要「全按缺省」就**省略**第 3 个参数：文件落在系统临时目录里。名字断言不了，但它是真写出来了 ——
# 读回来一次。（整个 STRUCT 传 NULL 不是这个意思，那是上一条的短路：连文件都不会有。）
query T
SELECT content FROM read_text(op_write_file('default options', 'txt'));
----
default options
